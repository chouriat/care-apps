      { "why": "confidence not a number", "patch": { "fieldConfidence": { "name": "high" } } },
      { "why": "empty name", "patch": { "name": "" } },
      { "why": "blank name", "patch": { "name": "   " } },
      { "why": "empty doseText", "patch": { "doseText": "" } },
      { "why": "name missing", "patch": { "name": null } },
      { "why": "rawText missing", "patch": { "rawText": null } },
      { "why": "strength is a number", "patch": { "strength": 500 } }
