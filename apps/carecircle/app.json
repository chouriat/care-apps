{
  "expo": {
    "name": "CareCircle",
    "slug": "carecircle",
    "version": "0.1.0",
    "scheme": "carecircle",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.carecircle.mobile"
    },
    "android": {
      "package": "app.carecircle.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "@sentry/react-native/expo",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CareCircle uses the camera to photograph a prescription label so it can fill in the medication for you.",
          "photosPermission": "CareCircle reads the prescription photo you choose so it can fill in the medication for you.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
